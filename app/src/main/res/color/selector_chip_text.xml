<?xml version="1.0" encoding="utf-8"?>
<!-- M3 filter chip 文字色: 选中(checked/selected)=on_secondary_container, 未选中=on_surface_variant -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorOnSecondaryContainer" />
    <item android:state_selected="true" android:color="?attr/colorOnSecondaryContainer" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
