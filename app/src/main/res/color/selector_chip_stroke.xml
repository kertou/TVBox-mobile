<?xml version="1.0" encoding="utf-8"?>
<!-- M3 filter chip 描边: 选中=消失, 未选中=1dp outline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@android:color/transparent" />
    <item android:state_selected="true" android:color="@android:color/transparent" />
    <item android:color="?attr/colorOutline" />
</selector>
