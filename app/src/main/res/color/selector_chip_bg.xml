<?xml version="1.0" encoding="utf-8"?>
<!-- M3 filter chip 背景: 选中=secondary_container 色调填充, 未选中=surface -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorSecondaryContainer" />
    <item android:state_selected="true" android:color="?attr/colorSecondaryContainer" />
    <item android:color="?attr/colorSurface" />
</selector>
