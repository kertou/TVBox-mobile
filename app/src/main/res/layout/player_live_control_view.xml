<?xml version="1.0" encoding="utf-8"?>
<!-- 直播播放器控制层(Material 3 重构):暂停遮罩/手势提示改用药丸浮层,加载指示器换 M3 官方组件;id/tag 与 LiveNewController/BaseController 保持兼容 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/tv_pause_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:tag="vod_control_pause"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_player_pill"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingVertical="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:src="@drawable/ic_m3_play_arrow" />

            <TextView
                android:id="@+id/tv_pause_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_20"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:tag="vod_control_pause_t"
                android:visibility="gone"
                android:textSize="20sp"
                tools:text="100"
                android:textColor="@color/white"/>
        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_slide_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_pill"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:tag="vod_control_slide_info"
        android:textAlignment="gravity"
        android:textSize="20sp"
        android:visibility="gone"
        tools:text="100"
        android:textColor="@color/white"/>

    <com.github.tvbox.osc.ui.widget.M3Loading
        android:id="@+id/play_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:saveEnabled="false"
        android:tag="vod_control_loading"
        android:visibility="gone"
        app:indicatorColor="@color/white"
        app:indicatorSize="48dp"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp"
        tools:visibility="visible"/>
</FrameLayout>
