<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="32dp"
        android:text="@string/app_name"
        android:textColor="@color/md_on_surface"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_m3_surface_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/tvHistory"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_history_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="观看历史" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvFavorite"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_collect_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="收藏" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvCache"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_cache_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="我的缓存" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvLive"
                    style="@style/M3MenuRowLast">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_live_tv_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="直播" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_m3_surface_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llSubscription"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_database_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="订阅管理" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvSetting"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="设置" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llAbout"
                    style="@style/M3MenuRowLast">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_about_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="关于" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/tv_version"
        android:textSize="11sp"
        tools:text="v0.01"
        android:paddingBottom="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/md_outline"
        />
</LinearLayout>
