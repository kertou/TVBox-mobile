<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器控制层(Material 3 重构):视频上叠加深色渐变 scrim,图标按钮按官方 48dp 触控目标/24dp 图标,进度条按 M3 Slider 形制(全圆角轨道+竖条手柄)。所有 id/tag 与 VodController/LocalVideoController 的绑定保持兼容 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceDarkAllowed="false"
    android:id="@+id/rootView"
    tools:background="@color/black">

    <!-- 顶部:整体遮罩内左(返回/标题/分辨率) 右(网速/时钟/电量/画中画/投屏/设置) -->
    <FrameLayout
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_scrim_top"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/tv_top_l_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back_btn"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_info_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxWidth="260dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="剧集名称" />

                <TextView
                    android:id="@+id/tv_videosize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:tag="vod_video_size"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    tools:text="1024 x 768" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tv_top_r_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/container_top_right_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="invisible"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_play_load_net_speed_right_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingEnd="6dp"
                    android:tag="vod_control_pause_time"
                    android:text="0Kb/s"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_sys_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingEnd="8dp"
                    android:tag="vod_control_pause_time"
                    android:text="12:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <com.github.tvbox.osc.ui.widget.MyBatteryView
                    android:id="@+id/battery"
                    android:layout_width="26dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/pip"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/pip"
                android:src="@drawable/ic_m3_pip"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/cast"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/cast"
                android:src="@drawable/ic_m3_cast"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/setting"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/setting"
                android:src="@drawable/ic_m3_settings"
                app:tint="@color/white" />

        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:id="@+id/iv_lock"
        style="@style/PlayerIconButton"
        android:layout_gravity="right|center"
        android:contentDescription="@string/lock"
        android:src="@drawable/ic_unlock"
        android:visibility="invisible"
        tools:visibility="visible"/>

    <com.github.tvbox.osc.subtitle.widget.SimpleSubtitleView
        android:id="@+id/subtitle_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_15"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_15"
        android:text=""
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- 底部:整体遮罩内 解析行 / 播放控制行 / (保留的旧设置行,入口已移至播放控制弹窗) -->
    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_scrim_bottom"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/parse_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/dp_5"
                android:layout_marginRight="@dimen/dp_5"
                android:paddingRight="@dimen/dp_10"
                android:text="解析"
                android:textColor="@color/white"
                 />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/play_status"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/play_pause"
                android:src="@drawable/ic_m3_pause"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/play_pre"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/pre_episode"
                android:src="@drawable/ic_m3_skip_previous"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <TextView
                android:id="@+id/curr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:paddingEnd="6dp"
                android:paddingRight="6dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="14sp"
                 />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@null"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:progressDrawable="@drawable/player_seek_track"
                android:thumb="@drawable/player_seek_thumb"
                android:thumbOffset="6dp" />

            <TextView
                android:id="@+id/total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingLeft="6dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginEnd="2dp"
                 />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/play_next"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/next_episode"
                android:src="@drawable/ic_m3_skip_next"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/choose_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_player_pill"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible"
                android:text="选集"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_fullscreen"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/fullscreen"
                android:src="@drawable/ic_m3_fullscreen"/>
        </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/container_playing_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/play_retry"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="重播"
                        android:textColor="@color/white"
                        android:layout_marginLeft="20dp"
                        />
                    <TextView
                        android:id="@+id/play_refresh"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="刷新"
                        android:textColor="@color/white"
                        />
                    <TextView
                        android:id="@+id/play_scale"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="16:9"
                        android:textColor="@color/white"
                        />

                    <TextView
                        android:id="@+id/play_speed"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="x1.0"
                        />

                    <TextView
                        android:id="@+id/play_player"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="系统"
                        />

                    <TextView
                        android:id="@+id/play_ijk"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="硬解码"
                        />

                    <TextView
                        android:id="@+id/play_time_start_end_text"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="片头/片尾"
                        android:textColor="@color/white"
                        />

                    <TextView
                        android:id="@+id/play_time_start"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="01:00"
                        />

                    <TextView
                        android:id="@+id/play_time_end"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="01:00"
                        />

                    <!--添加片头片尾重置按钮-->
                    <TextView
                        android:id="@+id/play_time_reset"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="重置"
                        />

                    <TextView
                        android:id="@+id/zimu_select"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="字幕"
                        />

                    <TextView
                        android:id="@+id/audio_track_select"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="音轨"
                        />

                    <TextView
                        android:id="@+id/landscape_portrait"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:layout_marginRight="@dimen/dp_5"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="横竖屏"
                        android:visibility="gone"
                        />

                </LinearLayout>

            </HorizontalScrollView>

    </LinearLayout>

<!--    亮度+音量调整-->
    <TextView
        android:id="@+id/tv_slide_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_pill"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:tag="vod_control_slide_info"
        android:textAlignment="gravity"
        tools:visibility="visible"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="音量+10" />

    <FrameLayout
        android:id="@+id/tv_progress_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_player_pill"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tv_progress_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                tools:src="@drawable/icon_back" />

            <TextView
                android:id="@+id/tv_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                tools:text="30:10/40:10"
                android:textColor="@color/white"
                android:textSize="14sp"/>

        </LinearLayout>
    </FrameLayout>

    <com.github.tvbox.osc.ui.widget.M3Loading
        android:id="@+id/play_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:saveEnabled="false"
        android:tag="vod_control_loading"
        android:visibility="gone"
        app:indicatorColor="@color/white"
        app:indicatorSize="48dp"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_play_load_net_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="76dp"
        android:background="@drawable/bg_player_pill"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:tag="play_load_net_speed"
        tools:text="10kb/s"
        android:textColor="@color/white"
        android:textSize="12sp"
         />

    <LinearLayout
        android:id="@+id/ll_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|top"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_player_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lt_speed"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:scaleX="3"
            android:scaleY="2"
            app:lottie_autoPlay="true"
            android:scaleType="centerCrop"
            app:lottie_fileName="forward_speed.json"
            app:lottie_loop="true"
            app:lottie_colorFilter="@color/white"
            app:lottie_repeatMode="restart"/>
        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="2.0"/>
    </LinearLayout>
</FrameLayout>
